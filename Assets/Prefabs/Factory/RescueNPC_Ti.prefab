  unconsciousLines:
  - speaker: "T\xED (Th\u1EC1u th\xE0o)"
    text: "Kh\u1EE5 kh\u1EE5... C\u1EE9u... C\u1EE9u em v\u1EDBi... Kh\xF3 th\u1EDF
