  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RescueNPC
  unconsciousLines:
  - speaker: "T\xED (Th\u1EC1u th\xE0o)"
    text: "Kh\u1EE5 kh\u1EE5... C\u1EE9u... C\u1EE9u em v\u1EDBi... Kh\xF3 th\u1EDF
      qu\xE1..."
    portrait: {fileID: 0}
  rescueLines:
  - speaker: Greenie
    text: "U\u1ED1ng thu\u1ED1c gi\u1EA3i n\xE0y \u0111i!"
    portrait: {fileID: 0}
  - speaker: "T\xED (T\u1EC9nh l\u1EA1i)"
    text: "C\u1EA3m \u01A1n anh... Em \u1ED5n h\u01A1n nhi\u1EC1u r\u1ED3i. \u0110\xE2y
      l\xE0 th\u1EBB t\u1EEB \u0111\u1EC3 v\xE0o khu v\u1EF1c l\xF5i nh\xE0 m\xE1y,
      anh c\u1EA7m l\u1EA5y \u0111i!"
    portrait: {fileID: 0}
  alreadySavedLines:
  - speaker: "T\xED"
    text: "C\u1EA3m \u01A1n anh m\u1ED9t l\u1EA7n n\u1EEFa. H\xE3y mau ng\u0103n
      ch\u1EB7n nh\xE0 m\xE1y x\u1EA3 th\u1EA3i!"
    portrait: {fileID: 0}
  unconsciousVisual: {fileID: 974587783441366356}
  awakeVisual: {fileID: 6337428285766859902}
  prompt: {fileID: 9068621932251615962}
