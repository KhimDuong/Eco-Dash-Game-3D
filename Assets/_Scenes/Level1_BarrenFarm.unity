    portrait: {fileID: 0}
  - speaker: "B\xE9 M\xE2y"
    text: "Em th\u1EA5y n\xF3 b\u1ECB d\u1EA1t v\u1EC1 ph\xEDa g\xF3c thung l\u0169ng,
