    portrait: {fileID: 0}
  inProgressLines:
  - speaker: "B\xE9 M\xE2y"
    text: "Anh t\xECm th\u1EA5y Robot c\u01B0ng c\u1EE7a em \u1EDF g\xF3c thung l\u0169ng
