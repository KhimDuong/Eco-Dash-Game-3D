    portrait: {fileID: 0}
  - speaker: "B\xE0 T\u01B0"
    text: "T\xECm gi\xFAp ta 3 L\xF5i N\u0103ng L\u01B0\u1EE3ng S\u1EA1ch gi\u1EA5u
      trong m\u1EA5y c\xE1i r\u01B0\u01A1ng g\u1ED7 c\u0169 nh\xE9! M\u1EDF h\u1EBFt
      r\u01B0\u01A1ng th\xEC \u0111\u1EA5t s\u1EBD h\u1ED3i sinh v\xE0 c\u1ED5ng
      d\u1ECBch chuy\u1EC3n s\u1EBD m\u1EDF."
    portrait: {fileID: 0}
  - speaker: "B\xE0 T\u01B0"
    text: "Nh\u1EDB k\u1EF9: ngu\u1ED3n \u0111\u1ED9c ch\u1EA3y ra t\u1EEB c\xE1i
      nh\xE0 m\xE1y Black Smoke. C\u1EA9n th\u1EADn \u0111\u1EA5y, ch\xE1u!"
    portrait: {fileID: 0}
  postCompletionLines:
  - speaker: "B\xE0 T\u01B0"
    text: "N\u01B0\u1EDBc gi\u1EBFng trong tr\u1EDF l\u1EA1i r\u1ED3i! C\u1EA3m \u01A1n
      ch\xE1u nhi\u1EC1u l\u1EAFm."
    portrait: {fileID: 0}
  - speaker: "B\xE0 T\u01B0"
    text: "Nh\u01B0ng g\u1ED1c r\u1EC5 v\u1EABn \u1EDF c\xE1i nh\xE0 m\xE1y Black
      Smoke kia k\xECa... B\u01B0\u1EDBc qua c\u1ED5ng \u0111i, v\xE0 c\u1EA9n th\u1EADn
      nghe ch\xE1u!"
    portrait: {fileID: 0}
