  m_Script: {fileID: 11500000, guid: b434c2cbf6acd5b40957d400e00d4f7e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SideQuestNPC
  questId: may_pet
  completion: 0
  turnInIds: []
  turnInCounts: 
  rewardItemId: 
  rewardItemCount: 0
  offerLines:
  - speaker: "B\xE9 M\xE2y"
    text: "Huhu... anh Greenie \u01A1i, con Robot c\u01B0ng c\u1EE7a em b\u1ECB l\u1EA1c
      m\u1EA5t r\u1ED3i!"
    portrait: {fileID: 0}
  - speaker: "B\xE9 M\xE2y"
    text: "Em th\u1EA5y n\xF3 b\u1ECB d\u1EA1t v\u1EC1 ph\xEDa g\xF3c thung l\u0169ng,
      n\u01A1i c\xF3 m\u1EA5y con Slime hung d\u1EEF l\u1EAFm... Anh gi\xFAp em t\xECm
      l\u1EA1i n\xF3 v\u1EDBi!"
    portrait: {fileID: 0}
  inProgressLines:
  - speaker: "B\xE9 M\xE2y"
    text: "Anh t\xECm th\u1EA5y Robot c\u01B0ng c\u1EE7a em \u1EDF g\xF3c thung l\u0169ng
      ch\u01B0a? Huhu..."
    portrait: {fileID: 0}
  readyLines: []
  doneLines:
  - speaker: "B\xE9 M\xE2y"
    text: "C\u1EA3m \u01A1n anh Greenie \u0111\xE3 t\xECm l\u1EA1i Robot cho em!
      Em s\u1EBD d\u1ECDn l\xEAn Tr\u1EA1m T\xE1i Ch\u1EBF \u1EDF v\u1EDBi \xD4ng
      Bear cho an to\xE0n."
    portrait: {fileID: 0}
  prompt: {fileID: 1051533616}
