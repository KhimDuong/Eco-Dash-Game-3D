  offerLines:
  - speaker: "\xD4ng S\xE1u"
    text: "C\u1EE9u v\u1EDBi! Greenie \u01A1i, c\xF3 ai kh\xF4ng c\u1EE9u \xF4ng
      v\u1EDBi!"
    portrait: {fileID: 0}
  - speaker: Greenie
    text: "C\xF3 chuy\u1EC7n g\xEC v\u1EADy \xD4ng S\xE1u?"
    portrait: {fileID: 0}
  - speaker: "\xD4ng S\xE1u"
    text: "Th\u1EB1ng T\xED nh\xE0 \xF4ng n\xF3 chui v\xE0o khu nh\xE0 m\xE1y r\u1ED3i.
      Ch\u1ED7 \u0111\xF3 kh\xF3i \u0111\u1ED9c l\u1EAFm! Nh\u1EDD ch\xE1u t\xECm
      3 c\xE2y L\xE1 Thu\u1ED1c quanh n\xF4ng tr\u1EA1i \u0111\u1EC3 \xF4ng ch\u1EBF
      thu\u1ED1c gi\u1EA3i ph\xF2ng th\xE2n cho n\xF3!"
    portrait: {fileID: 0}
  herbsInProgressLines:
  - speaker: "\xD4ng S\xE1u"
    text: "Nhanh l\xEAn ch\xE1u \u01A1i, 3 c\xE2y L\xE1 Thu\u1ED1c! T\xED n\xF3 kh\xF4ng
      tr\u1EE5 \u0111\u01B0\u1EE3c l\xE2u \u0111\xE2u!"
    portrait: {fileID: 0}
  herbsReadyLines:
  - speaker: "\xD4ng S\xE1u"
    text: "Ch\xE1u t\xECm \u0111\u1EE7 r\u1ED3i sao? Gi\u1ECFi qu\xE1! \u0110\u01B0a
      \xF4ng xem n\xE0o..."
    portrait: {fileID: 0}
  - speaker: "\xD4ng S\xE1u"
    text: "\u0110\xE2y l\xE0 Thu\u1ED1c Gi\u1EA3i M\u1EA7m Xanh \xF4ng v\u1EEBa nghi\u1EC1n.
      Ch\xE1u h\xE3y c\u1EA7m l\u1EA5y, mau qua khu nh\xE0 m\xE1y t\xECm T\xED gi\xFAp
      \xF4ng!"
    portrait: {fileID: 0}
  antidoteHeldLines:
  - speaker: "\xD4ng S\xE1u"
    text: "Ch\xE1u c\xF2n \u0111\u1EE9ng \u0111\xF3 l\xE0m g\xEC? T\xED \u0111ang
      nguy hi\u1EC3m l\u1EAFm, mau qua nh\xE0 m\xE1y \u0111i!"
    portrait: {fileID: 0}
  tiSavedLines:
  - speaker: "\xD4ng S\xE1u"
    text: "\xD4ng nghe tin ch\xE1u \u0111\xE3 c\u1EE9u \u0111\u01B0\u1EE3c T\xED
      r\u1ED3i. C\u1EA3m \u01A1n ch\xE1u nhi\u1EC1u l\u1EAFm Greenie!"
    portrait: {fileID: 0}
  prompt: {fileID: 1038522988}
