  turnInIds: []
  turnInCounts: 
  rewardItemId: portal_shard
  rewardItemCount: 1
  offerLines:
  - speaker: "\xD4ng T\xE0i"
    text: "Ch\xE0o ch\xE1u robot! C\xE1i ao n\xE0y b\u1ECB \xF4 nhi\u1EC5m r\xE1c
      th\u1EA3i n\u1EB7ng qu\xE1, l\xE3o kh\xF4ng c\xE2u c\xE1 \u0111\u01B0\u1EE3c
      n\u1EEFa."
    portrait: {fileID: 0}
  - speaker: "\xD4ng T\xE0i"
    text: "Ch\xE1u gi\xFAp l\xE3o d\u1ECDn s\u1EA1ch r\xE1c quanh ao \u0111\u1ED9c
      n\xE0y nh\xE9! L\xE3o s\u1EBD th\u01B0\u1EDFng cho ch\xE1u 1 M\u1EA3nh C\u1ED5ng
      D\u1ECBch Chuy\u1EC3n qu\xFD gi\xE1."
    portrait: {fileID: 0}
  inProgressLines:
  - speaker: "\xD4ng T\xE0i"
    text: "D\u1ECDn th\xEAm r\xE1c quanh ao gi\xFAp l\xE3o nh\xE9 ch\xE1u! \u0110\u1EE7
      r\xE1c l\xE3o m\u1EDBi c\xE2u c\xE1 l\u1EA1i \u0111\u01B0\u1EE3c."
    portrait: {fileID: 0}
  readyLines: []
  doneLines:
  - speaker: "\xD4ng T\xE0i"
    text: "N\u01B0\u1EDBc ao trong s\u1EA1ch l\u1EA1i r\u1ED3i! C\u1EA3m \u01A1n
      ch\xE1u nhi\u1EC1u l\u1EAFm, \u0111\xE2y l\xE0 M\u1EA3nh C\u1ED5ng nh\u01B0
      l\xE3o \u0111\xE3 h\u1EE9a."
    portrait: {fileID: 0}
  prompt: {fileID: 1020426445}
