  m_Script: {fileID: 11500000, guid: c80e46f3b00670147afeb27d08ed6205, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueNPC
  lines:
  - speaker: "B\xE0 T\u01B0"
    text: "\xD4i, m\u1ED9t con robot bi\u1EBFt d\u1ECDn r\xE1c sao? T\u1ED1t qu\xE1...
      Gi\u1EBFng l\xE0ng nhi\u1EC5m \u0111\u1ED9c h\u1EBFt c\u1EA3 r\u1ED3i, ch\xE1u
      \u01A1i."
    portrait: {fileID: 0}
  - speaker: "B\xE0 T\u01B0"
    text: "T\xECm gi\xFAp ta 3 L\xF5i N\u0103ng L\u01B0\u1EE3ng S\u1EA1ch gi\u1EA5u
      trong m\u1EA5y c\xE1i r\u01B0\u01A1ng g\u1ED7 c\u0169 nh\xE9! M\u1EDF h\u1EBFt
      r\u01B0\u01A1ng th\xEC \u0111\u1EA5t s\u1EBD h\u1ED3i sinh v\xE0 c\u1ED5ng
      d\u1ECBch chuy\u1EC3n s\u1EBD m\u1EDF."
    portrait: {fileID: 0}
  - speaker: "B\xE0 T\u01B0"
