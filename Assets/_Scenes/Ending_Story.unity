--- !u!114 &1327201805
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1327201804}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 741fe13667f504f428fd650aef463670, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StorySequence
  slides:
  - text: "C\u1ED7 m\xE1y Mega-Smog g\u1EA7m l\xEAn l\u1EA7n cu\u1ED1i r\u1ED3i n\u1ED5
      tung. M\xE0n kh\xF3i \u0111\u1ED9c d\xE0y \u0111\u1EB7c tan d\u1EA7n..."
    image: {fileID: 0}
  - text: "D\xF2ng n\u01B0\u1EDBc b\u1EAFt \u0111\u1EA7u ch\u1EA3y trong tr\u1EDF
      l\u1EA1i. Nh\u1EEFng m\u1EA7m xanh \u0111\xE2m ch\u1ED3i tr\xEAn n\u1EC1n \u0111\u1EA5t
      t\u1EEBng ch\u1EBFt kh\xF4."
    image: {fileID: 0}
  - text: "D\xE2n l\xE0ng l\u1EA7n l\u01B0\u1EE3t quay v\u1EC1. Ti\u1EBFng c\u01B0\u1EDDi
      tr\u1EBB th\u01A1 l\u1EA1i vang tr\xEAn c\xE1nh \u0111\u1ED3ng Greenvale."
    image: {fileID: 0}
  - text: "Greenie \u1EDF l\u1EA1i, l\u1EB7ng l\u1EBD canh gi\u1EEF m\u1ED9t Greenvale
      m\xE3i m\xE3i xanh t\u01B0\u01A1i."
    image: {fileID: 0}
  - text: "C\u1EA2M \u01A0N B\u1EA0N \u0110\xC3 CH\u01A0I!"
    image: {fileID: 0}
  bonusRescueSlide:
    text: "Nh\u1EDD c\xF3 b\u1EA1n, T\xED \u0111\xE3 \u0111\u01B0\u1EE3c c\u1EE9u
      s\u1ED1ng k\u1ECBp th\u1EDDi v\xE0 khu v\u1EF1c nh\xE0 m\xE1y c\u0169ng ng\u1EEBng
      vi\u1EC7c x\u1EA3 th\u1EA3i. H\u1EC7 sinh th\xE1i \u0111ang d\u1EA7n ph\u1EE5c
      h\u1ED3i!"
    image: {fileID: 0}
  captionText: {fileID: 1010715548}
  imageDisplay: {fileID: 1298665762}
  nextScene: MainMenu
  advanceSfx: {fileID: 8300000, guid: 85f8fe2dd10192b4d91739e89240c15c, type: 3}
